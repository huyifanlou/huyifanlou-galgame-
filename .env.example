# ============ LLM 接口（OpenAI 兼容格式）============
# 支持：DeepSeek / 通义千问 / Kimi / 智谱 / 任意 OpenAI 兼容网关
VITE_LLM_BASE_URL=https://api.deepseek.com/v1
VITE_LLM_API_KEY=sk-替换为你的密钥
VITE_LLM_MODEL=deepseek-chat

# ============ 说明 ============
# 1. 复制本文件为 .env 并填入密钥（.env 已被 .gitignore 忽略，不会提交）
# 2. 不配置密钥也能完整运行：游戏自动进入「演示模式」，
#    LLM 动态事件导演降级为内置规则事件池，核心功能闭环可完整复现（供评审无 Key 复现）
# 3. 密钥只允许存在于本机 .env 或部署平台环境变量中，禁止提交到仓库
